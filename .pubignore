# When `.pubignore` is present at the package root, `flutter pub
# publish` consults it instead of the package-root `.gitignore`.
# Sub-directory `.gitignore` files still apply (the example app's
# `.gitignore` covers Pods/, build/, etc.), so we only list
# entries that diverge from the gitignore at this level.

build
.github/

*.iml

# Libraries should not publish pubspec.lock per Dart's guidance:
# https://dart.dev/tools/pub/dependencies#lockfiles
# The package-root .gitignore also excludes it, but `.pubignore`
# shadows the gitignore at this level so we list it here too.
pubspec.lock

# Vendored copy of PreludeAuth's Swift sources, mirrored into
# the pod tree on every `pod install` from
# `PRELUDE_AUTH_SDK_LOCAL_PATH`. Non-deterministic across
# checkouts and only relevant during local development; the
# published pod fetches PreludeAuth by tag from the apple
# auth SDK repo. See `ios/prelude_flutter_auth_sdk.podspec`
# for the resolution rules. The package-root `.gitignore` also
# excludes this; duplicated here because `.pubignore` shadows it.
ios/sdk/

# Internal demo app. Bundled in the monorepo for end-to-end
# smoke testing of the plugin against a local PreludeAuth,
# but the public-repo publish script strips it out before
# `flutter pub publish` runs in CI. Mirror that exclusion
# here so a manual local publish (e.g. the first-time pub.dev
# package claim) produces an archive identical to what the
# automated workflow would publish.
example/
